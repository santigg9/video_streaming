DOMAIN=video.example.com
TURN_USERNAME=puente
TURN_CREDENTIAL=reemplazar-por-una-clave-larga-y-aleatoria

# Login (un solo usuario). Sin estas variables el sitio responde 503.
# Evitá el signo $ en los valores: docker compose lo interpreta.
AUTH_USERNAME=tu-usuario
AUTH_PASSWORD=reemplazar-por-una-contrasena-larga
# Firma las cookies de sesión. Generalo con: openssl rand -hex 32
SESSION_SECRET=reemplazar-por-64-caracteres-hex
